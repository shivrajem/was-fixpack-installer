#!/bin/bash
# Mock IBM Installation Manager imcl for tests. State: $FAKE_IM_STATE/installed (lines "dir : pkg : name : level"),
# $FAKE_IM_STATE/history (previous package ids for rollback). Controls: FAKE_IM_VER, FAKE_INSTALL_FAIL, FAKE_NO_VI_UPDATE.
S=${FAKE_IM_STATE:?}
echo "$*" >> "$S/calls"
lvl() { echo "$1" | awk -F_ '{n=split($2,p,"."); printf "%d.%d.%d.%d", p[1],p[2],int(p[3]/1000),p[3]%1000}'; }
setvi() { # dir pkg -> update fake versionInfo level for WAS packages
  case $2 in com.ibm.websphere.ND.*|com.ibm.websphere.BASE.*) [ -n "${FAKE_NO_VI_UPDATE:-}" ] || lvl "$2" > "$1/.vi_level" ;; esac; }
cmd=$1; shift
case $cmd in
  version) printf 'Installation Manager (install)\nVersion: %s\nInternal Version: %s.20250101_0000\n' "${FAKE_IM_VER:-1.9.3001}" "${FAKE_IM_VER:-1.9.3001}" ;;
  listInstalledPackages) cat "$S/installed" ;;
  listAvailablePackages)
    while [ $# -gt 0 ]; do [ "$1" = -repositories ] && R=$2; shift; done
    IFS=,; for r in $R; do [ -f "$r/packages.txt" ] && sed "s|^|$r : |" "$r/packages.txt"; done ;;
  install)
    [ -n "${FAKE_INSTALL_FAIL:-}" ] && { echo "CRIMC1029E: install failed"; exit 1; }
    pk=(); while [ $# -gt 0 ]; do case $1 in -installationDirectory) D=$2; shift 2;; -*) [ "$1" = -acceptLicense ] || [ "$1" = -showProgress ] && shift || shift 2;; *) pk+=("$1"); shift;; esac; done
    for p in "${pk[@]}"; do
      off=${p%%_*}
      old=$(awk -F' : ' -v d="$D" -v o="${off}_" '$1==d && index($2,o)==1 {print $2}' "$S/installed")
      echo "$off $old" >> "$S/history"
      awk -F' : ' -v d="$D" -v o="${off}_" '!($1==d && index($2,o)==1)' "$S/installed" > "$S/i.tmp"
      echo "$D : $p : name : $(lvl "$p")" >> "$S/i.tmp"; mv "$S/i.tmp" "$S/installed"; setvi "$D" "$p"
    done ;;
  rollback)
    pk=(); while [ $# -gt 0 ]; do case $1 in -installationDirectory) D=$2; shift 2;; -log) shift 2;; *) pk+=("$1"); shift;; esac; done
    for off in "${pk[@]}"; do
      prev=$(awk -v o="$off" '$1==o {p=$2} END{print p}' "$S/history")
      [ -n "$prev" ] || { echo "CRIMC1085E: nothing to roll back for $off"; exit 1; }
      awk -F' : ' -v d="$D" -v o="${off}_" '!($1==d && index($2,o)==1)' "$S/installed" > "$S/i.tmp"
      echo "$D : $prev : name : $(lvl "$prev")" >> "$S/i.tmp"; mv "$S/i.tmp" "$S/installed"; setvi "$D" "$prev"
    done ;;
  *) echo "mock imcl: unsupported $cmd"; exit 2 ;;
esac
